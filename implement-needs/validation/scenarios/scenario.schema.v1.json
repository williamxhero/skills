{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "version", "topology"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "topology": {"const": "whole-spec"},
    "expected_artifact_counts": {"type": "object"},
    "specs": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
