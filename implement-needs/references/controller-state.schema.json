{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/williamxhero/skills/implement-needs/controller-state.schema.json",
  "title": "Implement Needs controller state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "state_revision",
    "controller_state",
    "active_phase",
    "active_task_stack",
    "child_tasks",
    "implementation_ownership",
    "pending_specs",
    "unverified_handoffs",
    "unarchived_tasks",
    "test_state",
    "release_state",
    "next_action",
    "resume_action",
    "freshness",
    "terminal"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "state_revision": {"type": "integer", "minimum": 1},
    "controller_state": {
      "enum": ["active", "terminal_success", "terminal_blocked", "user_stopped"]
    },
    "active_phase": {
      "enum": ["bootstrap", "planning", "implementation", "testing", "release", "blocked", "stopped", "complete"]
    },
    "active_task_stack": {"$ref": "#/$defs/uniqueStrings"},
    "child_tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/childTask"}
    },
    "implementation_ownership": {"$ref": "#/$defs/implementationOwnership"},
    "pending_specs": {"$ref": "#/$defs/uniqueStrings"},
    "unverified_handoffs": {"$ref": "#/$defs/uniqueStrings"},
    "unarchived_tasks": {"$ref": "#/$defs/uniqueStrings"},
    "test_state": {"$ref": "#/$defs/testState"},
    "release_state": {"$ref": "#/$defs/releaseState"},
    "next_action": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/action"}]
    },
    "resume_action": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/action"}]
    },
    "freshness": {"$ref": "#/$defs/freshness"},
    "terminal": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/terminal"}]
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nullableRevision": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    },
    "nullableString": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    },
    "childTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "spec_id", "lifecycle"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["planning", "spec", "repair"]},
        "spec_id": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "lifecycle": {
          "enum": ["queued", "active", "paused", "handoff_received", "verified", "archived"]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "instruction"],
      "properties": {
        "kind": {
          "description": "Canonical controller action verb. Validator-specific recovery detail belongs in target and instruction; planning-gate failures use repair rather than adding gate-specific kinds.",
          "enum": ["wait", "verify", "archive", "repair", "dispatch", "advance", "resume", "refresh_state", "repair_state"]
        },
        "target": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1}
      }
    },
    "testState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_revision", "evidence", "l4_checkpoints"],
      "properties": {
        "status": {"enum": ["pending", "running", "passed", "blocked"]},
        "candidate_revision": {"$ref": "#/$defs/nullableRevision"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "l4_checkpoints": {"$ref": "#/$defs/l4CheckpointState"}
      }
    },
    "l4CheckpointState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_size",
        "ordered_specs",
        "completed_spec_count",
        "checkpoints",
        "release_l4"
      ],
      "properties": {
        "checkpoint_size": {"const": 10},
        "ordered_specs": {"$ref": "#/$defs/uniqueStrings"},
        "completed_spec_count": {"type": "integer", "minimum": 0},
        "checkpoints": {
          "type": "array",
          "items": {"$ref": "#/$defs/l4Checkpoint"}
        },
        "release_l4": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/releaseL4"}]
        }
      }
    },
    "l4Checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_spec_index",
        "end_spec_index",
        "specs",
        "final_tail",
        "affected_owners",
        "affected_repositories",
        "status",
        "revision",
        "candidate_revisions",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "start_spec_index": {"type": "integer", "minimum": 1},
        "end_spec_index": {"type": "integer", "minimum": 1},
        "specs": {"$ref": "#/$defs/uniqueStrings"},
        "final_tail": {"type": "boolean"},
        "affected_owners": {"$ref": "#/$defs/uniqueStrings"},
        "affected_repositories": {"$ref": "#/$defs/uniqueStrings"},
        "status": {"enum": ["pending", "running", "passed", "failed"]},
        "revision": {"$ref": "#/$defs/nullableRevision"},
        "candidate_revisions": {"$ref": "#/$defs/uniqueStrings"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "releaseL4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "checkpoint_id", "candidate_revisions", "evidence"],
      "properties": {
        "mode": {"enum": ["reused_checkpoint", "rerun_final"]},
        "checkpoint_id": {
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "candidate_revisions": {"$ref": "#/$defs/uniqueStrings"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "releaseState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_revision", "evidence"],
      "properties": {
        "status": {"enum": ["pending", "building", "packaged", "deployed", "not_applicable", "blocked"]},
        "candidate_revision": {"$ref": "#/$defs/nullableRevision"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_map_sha256", "task_tree_sha256"],
      "properties": {
        "delivery_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "task_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidence", "stopping_rule_met", "user_stop_recorded"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "stopping_rule_met": {"type": "boolean"},
        "user_stop_recorded": {"type": "boolean"}
      }
    },
    "implementationOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specs",
        "ticket_implementation_artifacts",
        "role_limited_tasks"
      ],
      "properties": {
        "specs": {
          "type": "array",
          "items": {"$ref": "#/$defs/specOwnership"}
        },
        "ticket_implementation_artifacts": {
          "$ref": "#/$defs/ticketImplementationArtifacts"
        },
        "role_limited_tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/roleLimitedTask"}
        }
      }
    },
    "specOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id", "implementation_task_id", "owners", "repositories", "route", "tickets"],
      "properties": {
        "spec_id": {"type": "string", "minLength": 1},
        "implementation_task_id": {"type": "string", "minLength": 1},
        "owners": {"$ref": "#/$defs/uniqueStrings"},
        "repositories": {"$ref": "#/$defs/uniqueStrings"},
        "route": {"$ref": "#/$defs/specImplementationRoute"},
        "tickets": {
          "type": "array",
          "items": {"$ref": "#/$defs/ticketExecution"}
        }
      }
    },
    "specImplementationRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "task_id", "selection", "model", "thinking", "evidence"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "selection": {"enum": ["recommended", "fallback"]},
        "model": {"type": "string", "minLength": 1},
        "thinking": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "ticketExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner_task_id",
        "blocked_by",
        "commits",
        "test_evidence",
        "tracker_state"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "owner_task_id": {"type": "string", "minLength": 1},
        "blocked_by": {"$ref": "#/$defs/uniqueStrings"},
        "commits": {"$ref": "#/$defs/evidence"},
        "test_evidence": {"$ref": "#/$defs/evidence"},
        "tracker_state": {"enum": ["planned", "active", "closed"]}
      }
    },
    "ticketImplementationArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "threads", "worktrees", "branches", "pull_requests"],
      "properties": {
        "tasks": {"$ref": "#/$defs/uniqueStrings"},
        "threads": {"$ref": "#/$defs/uniqueStrings"},
        "worktrees": {"$ref": "#/$defs/uniqueStrings"},
        "branches": {"$ref": "#/$defs/uniqueStrings"},
        "pull_requests": {"$ref": "#/$defs/uniqueStrings"}
      }
    },
    "roleLimitedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "spec_id",
        "parent_task_id",
        "role",
        "writes_product_code",
        "merge_commits",
        "evidence"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "spec_id": {"$ref": "#/$defs/nullableString"},
        "parent_task_id": {"$ref": "#/$defs/nullableString"},
        "role": {
          "enum": ["blocker_repair", "read_only_exploration", "read_only_review"]
        },
        "writes_product_code": {"type": "boolean"},
        "merge_commits": {"$ref": "#/$defs/uniqueStrings"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "taskTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "tasks", "implementation_ownership"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/childTask"}
        },
        "implementation_ownership": {"$ref": "#/$defs/implementationOwnership"}
      }
    }
  }
}
